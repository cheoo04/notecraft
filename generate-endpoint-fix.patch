diff --git a/backend/services/ai_client.py b/backend/services/ai_client.py
index d2364ac..1e74848 100644
--- a/backend/services/ai_client.py
+++ b/backend/services/ai_client.py
@@ -5,13 +5,85 @@ Centraliser l'appel ici permet, plus tard, de remplacer l'API externe
 par un modèle auto-hébergé (fine-tuné en LoRA/QLoRA, servi via
 llama.cpp/Ollama) sans changer les routes ni le code Flutter :
 seule cette fonction change.
+
+Fournisseur choisi via la variable d'environnement AI_PROVIDER
+("groq" par défaut, ou "anthropic").
+"""
+
+import os
+
+import httpx
+
+GROQ_API_URL = "https://api.groq.com/openai/v1/chat/completions"
+GROQ_DEFAULT_MODEL = "openai/gpt-oss-120b"
+ANTHROPIC_DEFAULT_MODEL = "claude-sonnet-4-6"
+
+Message = dict[str, str]
+
+
+def _call_groq(messages: list[Message]) -> str:
+    api_key = os.environ["GROQ_API_KEY"]
+    model = os.environ.get("GROQ_MODEL", GROQ_DEFAULT_MODEL)
+
+    response = httpx.post(
+        GROQ_API_URL,
+        headers={"Authorization": f"Bearer {api_key}"},
+        json={"model": model, "messages": messages, "temperature": 0.7},
+        timeout=55.0,
+    )
+    response.raise_for_status()
+    return response.json()["choices"][0]["message"]["content"]
+
+
+def _call_anthropic(messages: list[Message]) -> str:
+    import anthropic
+
+    client = anthropic.Anthropic()  # lit ANTHROPIC_API_KEY dans l'environnement
+    model = os.environ.get("ANTHROPIC_MODEL", ANTHROPIC_DEFAULT_MODEL)
+
+    response = client.messages.create(
+        model=model,
+        max_tokens=4096,
+        messages=messages,
+    )
+    return "".join(block.text for block in response.content if block.type == "text")
+
+
+def _call(messages: list[Message]) -> str:
+    provider = os.environ.get("AI_PROVIDER", "groq")
+    if provider == "groq":
+        return _call_groq(messages)
+    if provider == "anthropic":
+        return _call_anthropic(messages)
+    raise ValueError(f"AI_PROVIDER inconnu : {provider!r}")
+
+
+_REVIEW_INSTRUCTIONS = """
+Voici un premier brouillon de document. Relis-le et corrige-le pour :
+- respecter strictement les consignes de style données au premier tour
+  (pas de tiret cadratin, pas de sur-listage, ton naturel non robotique)
+- améliorer la clarté, la cohérence et enchaîner mieux les idées
+- corriger les répétitions ou lourdeurs de style
+
+Ne fais aucun commentaire ni introduction, renvoie uniquement la version
+corrigée du document.
+
+Brouillon :
+{draft}
 """
 
 
 def generate(prompt: str, mode: str) -> str:
-    # TODO:
-    # mode == "express" : un seul appel, réponse courte attendue
-    # mode == "affine"  : plusieurs passes (brouillon -> relecture ->
-    #                     vérification du style "non-IA", voir section 5.3
-    #                     du cahier des charges)
-    raise NotImplementedError
+    if mode == "express":
+        # Une seule passe de génération, réponse rapide.
+        return _call([{"role": "user", "content": prompt}])
+
+    if mode == "affine":
+        # Brouillon puis relecture/correction de style. Reste synchrone :
+        # avec Groq, les deux appels tiennent largement dans les 60s
+        # configurés côté Vercel (voir section 5.3 du cahier des charges).
+        draft = _call([{"role": "user", "content": prompt}])
+        review_prompt = _REVIEW_INSTRUCTIONS.format(draft=draft)
+        return _call([{"role": "user", "content": review_prompt}])
+
+    raise ValueError(f"mode inconnu : {mode!r}")
