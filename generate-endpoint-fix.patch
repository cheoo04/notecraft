+from models.schemas import DocumentFormat
+
+from . import expose, fiche_cornell, plan_de_cours, rapport, resume
+
+# Associe chaque format de sortie au module qui construit son prompt.
+# fiche_de_revision -> fiche_cornell : c'est la méthode Cornell qui est
+# utilisée pour ce format, d'où le nom de module différent.
+_BUILDERS = {
+    DocumentFormat.resume: resume.build_prompt,
+    DocumentFormat.rapport: rapport.build_prompt,
+    DocumentFormat.expose: expose.build_prompt,
+    DocumentFormat.plan_de_cours: plan_de_cours.build_prompt,
+    DocumentFormat.fiche_de_revision: fiche_cornell.build_prompt,
+}
+
+
+def build_prompt(format: DocumentFormat, note_content: str) -> str:
+    return _BUILDERS[format](note_content)
